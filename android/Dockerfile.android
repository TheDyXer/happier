# syntax=docker/dockerfile:1.7
# Own Android build of the Happy app ("Happy (colombus)", fun.colombus.happy):
# official slopus/happy source at $HAPPY_TAG + patches/*.patch (newer models, own variant),
# default server https://happy.colombus.fun, OTA updates off, no Firebase/push.
# Build context: ./src. Run via build-apk.sh (needs the keystore secret).

# RN 0.83.1 needs SDK 36, build-tools 36.0.0, NDK 27.1.12297006, JDK 17: exactly this tag.
FROM reactnativecommunity/react-native-android:v20.1 AS build

RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

WORKDIR /repo

# Dependencies first (cached unless the lockfile or package.json files change).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY scripts ./scripts
COPY patches ./patches
RUN mkdir -p packages/happy-app packages/happy-wire
COPY packages/happy-app/package.json packages/happy-app/
COPY packages/happy-wire/package.json packages/happy-wire/
COPY packages/happy-app/patches packages/happy-app/patches
# Repo default linker (hoisted, from .npmrc): Android autolinking expects that layout.
RUN SKIP_HAPPY_WIRE_BUILD=1 pnpm install --frozen-lockfile --filter happy-app...

COPY packages/happy-wire ./packages/happy-wire
COPY packages/happy-app ./packages/happy-app
RUN pnpm --filter @slopus/happy-wire build

ARG HAPPY_BUILD_COMMIT_SHA=""
# Needed by prebuild AND by Gradle (the JS bundle is built inside assembleRelease).
ENV APP_ENV=colombus \
    NODE_ENV=production \
    EXPO_PUBLIC_HAPPY_SERVER_URL=https://happy.colombus.fun \
    HAPPY_BUILD_COMMIT_SHA=$HAPPY_BUILD_COMMIT_SHA \
    EXPO_NO_TELEMETRY=1

WORKDIR /repo/packages/happy-app
# Print the evaluated config into the build log as a check.
RUN npx expo config --type public --json | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const c=JSON.parse(s);console.log("CONFIG CHECK",JSON.stringify({name:c.name,pkg:c.android.package,gsf:c.android.googleServicesFile??null,updates:c.updates,eas:c.extra&&c.extra.eas}))})'
RUN npx expo prebuild --platform android --no-install --clean

# Own signing key (stable across rebuilds, so updates install over the old app). Mounted as a
# secret, copied over the template's public debug keystore (alias androiddebugkey / android),
# never stored in an image layer.
RUN --mount=type=secret,id=keystore,required=true \
    --mount=type=cache,target=/root/.gradle \
    cp /run/secrets/keystore android/app/debug.keystore \
 && cd android \
 && ./gradlew assembleRelease \
      -PreactNativeArchitectures=arm64-v8a \
      -Dorg.gradle.jvmargs="-Xmx3g -XX:MaxMetaspaceSize=1g" \
      --max-workers=3 --no-daemon --stacktrace \
 && rm -f app/debug.keystore \
 && mkdir -p /out \
 && cp app/build/outputs/apk/release/app-release.apk /out/happy-colombus.apk

FROM scratch AS out
COPY --from=build /out/ /
