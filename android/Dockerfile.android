# syntax=docker/dockerfile:1.7
# Android build of Happier (fun.colombus.happier): official slopus/happy source at a cli-X.Y.Z tag
# + patches/*.patch (newer models, own variant), default server https://happy.colombus.fun,
# OTA updates off, no Firebase/push. Build context: the patched source tree.

# RN 0.83.1 needs SDK 36, build-tools 36.0.0, NDK 27.1.12297006, JDK 17: exactly this tag.
FROM reactnativecommunity/react-native-android:v20.1 AS build

RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

WORKDIR /repo

# Dependencies first (cached unless the lockfile or package.json files change).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY scripts ./scripts
COPY patches ./patches
RUN mkdir -p packages/happy-app packages/happy-wire
COPY packages/happy-app/package.json packages/happy-app/
COPY packages/happy-wire/package.json packages/happy-wire/
COPY packages/happy-app/patches packages/happy-app/patches
# Repo default linker (hoisted, from .npmrc): Android autolinking expects that layout.
RUN SKIP_HAPPY_WIRE_BUILD=1 pnpm install --frozen-lockfile --filter happy-app...

COPY packages/happy-wire ./packages/happy-wire
COPY packages/happy-app ./packages/happy-app
RUN pnpm --filter @slopus/happy-wire build

ARG HAPPY_BUILD_COMMIT_SHA=""
# Release number N: version X.Y.Z+N, versionCode 100+N (0 = test build, version unchanged).
ARG HAPPIER_BUILD=0
# Needed by prebuild AND by Gradle (the JS bundle is built inside assembleRelease).
ENV APP_ENV=happier \
    NODE_ENV=production \
    EXPO_PUBLIC_HAPPY_SERVER_URL=https://happy.colombus.fun \
    HAPPY_BUILD_COMMIT_SHA=$HAPPY_BUILD_COMMIT_SHA \
    HAPPIER_BUILD=$HAPPIER_BUILD \
    EXPO_NO_TELEMETRY=1

WORKDIR /repo/packages/happy-app
# Print the evaluated config into the build log as a check.
RUN npx expo config --type public --json | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const c=JSON.parse(s);console.log("CONFIG CHECK",JSON.stringify({name:c.name,pkg:c.android.package,version:c.version,code:c.android.versionCode??1,gsf:c.android.googleServicesFile??null,updates:c.updates,eas:c.extra&&c.extra.eas}))})'
RUN npx expo prebuild --platform android --no-install --clean

# Signing key mounted as a secret (alias androiddebugkey / android), copied over the template's public
# debug keystore, never stored in an image layer. Builders that hand the APK to a separate signing
# step pass a throwaway key. Worker count / heap per host.
ARG GRADLE_WORKERS=3
ARG GRADLE_XMX=3g
# Phones only need arm64-v8a. "arm64-v8a,x86_64" makes a test build that also runs in an x86_64 emulator.
ARG RN_ARCHS=arm64-v8a
# A new value forces a fresh Gradle compile; earlier steps stay cached.
ARG CACHE_BUST=
RUN --mount=type=secret,id=keystore,required=true \
    --mount=type=cache,target=/root/.gradle \
    cp /run/secrets/keystore android/app/debug.keystore \
 && cd android \
 && ./gradlew assembleRelease \
      -PreactNativeArchitectures=${RN_ARCHS} \
      -Dorg.gradle.jvmargs="-Xmx${GRADLE_XMX} -XX:MaxMetaspaceSize=1g" \
      --max-workers=${GRADLE_WORKERS} --no-daemon --stacktrace \
 && rm -f app/debug.keystore \
 && mkdir -p /out \
 && cp app/build/outputs/apk/release/app-release.apk /out/happier.apk

FROM scratch AS out
COPY --from=build /out/ /
